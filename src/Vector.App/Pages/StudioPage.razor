@page "/"
@implements IDisposable
@inject StudioState State
@inject NavigationManager Nav

<div class="studio-intro">
    <p class="eyebrow">Decision studio / 01</p>
    <h1 @ref="_heading" tabindex="-1">Which architecture fits the constraints?</h1>
    <p class="lede">
        Compare four bounded architecture patterns against the constraints you set. Vector keeps the
        assumptions, weights, hard requirements, and trade-offs visible. The result is decision support,
        not a verdict.
    </p>
    <p class="method-strip">
        <span class="fd-shell__label">Method</span>
        Deterministic, integer-only scoring with inspectable contributions and a reproducible digest.
    </p>
</div>

@if (_banner is not null)
{
    <div class="banner" role="status">
        <span>@_banner</span>
        <button type="button" @onclick="DismissBanner">Dismiss</button>
    </div>
}

<ScenarioPicker OnScenarioSelected="RequestFocus" />

<div class="studio-workspace">
    <ConstraintEditor />
    <ComparisonView />
</div>

<div class="studio-followup">
    <SensitivityPanel />
    <RiskMitigationList />
    <RationaleEditor />
    <ActionBar />
</div>

<section id="methodology" class="methodology-note" aria-labelledby="methodology-heading">
    <p class="eyebrow">Method / 04</p>
    <h2 id="methodology-heading">Read the comparison as a trace</h2>
    <p>
        Scores are coarse ordinal judgements, not measurements. A close result is effectively a tie;
        inspect the contribution detail, hard requirements, risks, and sensitivity before recording a decision.
    </p>
</section>

@code {
    private ElementReference _heading;
    private bool _pendingFocus;
    private string? _banner;

    protected override Task OnInitializedAsync()
    {
        State.OnChange += HandleStateChanged;

        var uri = Nav.Uri;
        var hashIndex = uri.IndexOf('#');
        var fragment = hashIndex >= 0 ? uri[(hashIndex + 1)..] : string.Empty;

        if (!string.IsNullOrEmpty(fragment))
        {
            var result = ShareCodec.Decode(fragment);
            if (result.Ok && result.Payload is not null)
            {
                State.HydrateFromShare(result.Payload);
                _pendingFocus = true;
            }
            else
            {
                _banner = BannerFor(result.Error);
            }
        }

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus)
        {
            _pendingFocus = false;
            await _heading.FocusAsync();
        }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private Task RequestFocus()
    {
        _pendingFocus = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void DismissBanner() => _banner = null;

    /// <summary>Plain-language reason shown when a share fragment could not be applied.</summary>
    private static string BannerFor(ShareError error) => error switch
    {
        ShareError.BadVersion => "This link is for a different version of Vector.",
        ShareError.TooLarge => "This link is too large.",
        _ => "This link is malformed.",
    };

    public void Dispose()
    {
        State.OnChange -= HandleStateChanged;
    }
}
