@implements IDisposable
@inject StudioState State

<section class="constraint-editor shell-panel" aria-labelledby="constraints-heading">
    <div class="section-heading">
        <p class="eyebrow">Shape the inputs / 03</p>
        <h2 id="constraints-heading">Constraints</h2>
        <p>
            Set the level, importance, and hard-requirement status for each dimension. The comparison updates
            as you work. Current tier total: <strong>@TotalWeightTier</strong>.
        </p>
    </div>

    <div class="constraint-list">
        @foreach (var dimension in PrimaryDimensions)
        {
            <ConstraintRow Dimension="dimension" />
        }

        <details class="advanced-constraints">
            <summary>
                <span>Advanced constraints</span>
                <span class="summary-meta">5 more dimensions</span>
            </summary>
            @foreach (var dimension in AdvancedDimensions)
            {
                <ConstraintRow Dimension="dimension" />
            }
        </details>
    </div>
</section>

@code {
    private static readonly ConstraintDimension[] Dimensions =
        [.. Enum.GetValues<ConstraintDimension>().OrderBy(d => (int)d)];

    private static readonly ConstraintDimension[] PrimaryDimensions = Dimensions[..3];

    private static readonly ConstraintDimension[] AdvancedDimensions = Dimensions[3..];

    private int TotalWeightTier => State.Profile.Settings.Sum(s => s.WeightTier);

    // Needed for the tier-total note above; each ConstraintRow separately subscribes for its own display.
    protected override void OnInitialized() => State.OnChange += StateHasChanged;

    public void Dispose() => State.OnChange -= StateHasChanged;
}
