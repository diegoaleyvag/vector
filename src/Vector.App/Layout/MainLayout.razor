@inherits LayoutComponentBase

<a class="skip-link" href="#main">Skip to main content</a>

<div class="page fd-shell">
    <header class="site-header">
        <a class="brand fd-shell__identity" href="/" aria-label="Vector studio home">Vector</a>
        <div class="header-context">
            <span class="fd-shell__label">Five Decisions / Studio</span>
            <span class="brand-subtitle">Architecture decision support</span>
        </div>
        <nav class="site-nav" aria-label="Vector navigation">
            <a href="#main">Studio</a>
            <a href="https://github.com/diegoaleyvag/vector/blob/384dd00294ffec38f215b989bb9335404793a0d8/docs/decision-method.md" target="_blank" rel="noopener noreferrer">Methodology</a>
            <a href="https://github.com/diegoaleyvag/vector" target="_blank" rel="noopener noreferrer">Source repository</a>
        </nav>
    </header>

    <div role="status" aria-live="polite" class="live-region">@_liveMessage</div>

    <main id="main">
        <CascadingValue Value="_announce" Name="Announce">
            @Body
        </CascadingValue>
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <p>
                Vector is a decision-support teaching tool. Scores are coarse ordinal judgments, not measurements;
                close scores are effectively ties. It does not certify or endorse any architecture.
            </p>
            <nav class="footer-nav" aria-label="Footer navigation">
                <a href="#main">Return to studio</a>
                <a href="https://github.com/diegoaleyvag/vector/blob/384dd00294ffec38f215b989bb9335404793a0d8/docs/decision-method.md" target="_blank" rel="noopener noreferrer">Methodology</a>
                <a href="https://github.com/diegoaleyvag/vector" target="_blank" rel="noopener noreferrer">Source repository</a>
                <a href="https://five-decisions-vector.vercel.app" target="_blank" rel="noopener noreferrer">Stable public demo</a>
            </nav>
        </div>
    </footer>
</div>

@code {
    private string? _liveMessage;
    private Action<string> _announce = default!;

    protected override void OnInitialized()
    {
        _announce = Announce;
    }

    /// <summary>Announces a message in the page's polite live region. Passed to descendants as a cascading "Announce" delegate.</summary>
    private void Announce(string message)
    {
        _liveMessage = message;
        StateHasChanged();
    }
}
