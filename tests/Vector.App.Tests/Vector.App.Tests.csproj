    <Content Include="..\..\src\Vector.App\wwwroot\css\app.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>css\app.css</Link>
    </Content>
    <Content Include="Fixtures\portfolio.project.schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
