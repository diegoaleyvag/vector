    <ProjectReference Include="..\..\src\Vector.Engine\Vector.Engine.csproj" />
    <ProjectReference Include="..\..\src\Vector.Domain\Vector.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\Vector.App\wwwroot\data\vector-knowledge.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>data\vector-knowledge.v1.json</Link>
    </Content>
    <Content Include="..\..\portfolio.project.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>portfolio.project.json</Link>
